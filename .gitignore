# ==============================================================================
#                      Python & Package Management
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
eggs/

# Installer logs & reports
pip-log.txt
.coverage
.cache
htmlcov/


# ==============================================================================
#                      Secrets & Environment
# ==============================================================================
.env
*.pem
*.key
*.crt
*.p12

# config.toml holds only $VAR placeholders (real values live in .env).
config.toml


# ==============================================================================
#                      Virtual Environments
# ==============================================================================
.venv
env/
venv/
ENV/


# ==============================================================================
#                      Django Specific
# ==============================================================================
# Local SQLite database file — this project's actual, real database.
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal

# Log files (text formatter).
*.log

# Project-specific folders generated by Django or our configuration.
# Covers both text (*.log) and JSON (project.json) log output — see
# LOGGING in settings.py — since the whole directory is ignored, not just
# one extension.
# The leading '/' ensures we only ignore these folders at the project root.
/backend/staticfiles/
/backend/mediafiles/
/backend/logs/
/logs/


# ==============================================================================
#                      OS & Editor Specific
# ==============================================================================

# macOS
.DS_Store

# VS Code
.vscode/
settings.json

# JetBrains (PyCharm/IntelliJ) — can contain saved DB connection strings.
.idea/

# .agents Claude Code bridge + graphify output (regenerated locally, never commit)
/CLAUDE.md
/.claude/agents/
/.claude/commands/
/.claude/skills/
/.claude/settings.local.json
/graphify-out/
